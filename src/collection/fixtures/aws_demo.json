    "AWS-07": {"raw": {
      "Regions": {"eu-west-3": {"EbsEncryptionByDefault": true}},
      "Buckets": [{"Name": "medsecure-backups", "Encryption": true}, {"Name": "medsecure-portal-assets", "Encryption": true}],
      "DBInstances": [{"DBInstanceIdentifier": "telesuivi-db", "StorageEncrypted": true},
                      {"DBInstanceIdentifier": "legacy-reporting", "StorageEncrypted": false}]}},
    "AWS-08": {"raw": {"Trails": [{"Name": "medsecure-org-trail", "IsMultiRegionTrail": true,
                                   "LogFileValidationEnabled": true, "Status": {"IsLogging": true}}]}},
    "AWS-09": {"raw": {"SecurityGroups": [
      {"GroupId": "sg-0a1web", "Region": "eu-west-3", "IpPermissions": [
        {"IpProtocol": "tcp", "FromPort": 443, "ToPort": 443, "IpRanges": [{"CidrIp": "0.0.0.0/0"}]}]},
      {"GroupId": "sg-0b2bastion", "Region": "eu-west-3", "IpPermissions": [
        {"IpProtocol": "tcp", "FromPort": 22, "ToPort": 22, "IpRanges": [{"CidrIp": "0.0.0.0/0"}]}]},
      {"GroupId": "sg-0c3db", "Region": "eu-west-3", "IpPermissions": [
        {"IpProtocol": "tcp", "FromPort": 5432, "ToPort": 5432, "IpRanges": [{"CidrIp": "10.0.0.0/16"}]}]}]}},
    "AWS-10": {"raw": {
      "ProtectedResources": [{"ResourceArn": "arn:aws:rds:eu-west-3:111122223333:db:telesuivi-db", "LastCompletedRecoveryPoint": "@-10h"},
                             {"ResourceArn": "arn:aws:s3:::medsecure-backups", "LastCompletedRecoveryPoint": "@-9h"}],
      "DBInstances": [{"DBInstanceIdentifier": "telesuivi-db", "BackupRetentionPeriod": 14}]}},
    "AWS-11": {"raw": {"Regions": {"eu-west-3": {"GuardDuty": true, "SecurityHub": true},
                                   "eu-central-1": {"GuardDuty": true, "SecurityHub": false}}}},
    "AWS-12": {"raw": {"Vpcs": [], "FlowLogs": []}},
    "AWS-13": {"raw": {"Listeners": [
      {"ListenerArn": "arn:aws:elasticloadbalancing:eu-west-3:111122223333:listener/app/portail/1/http",
       "Protocol": "HTTP", "Port": 80, "DefaultActions": [{"Type": "redirect", "RedirectConfig": {"Protocol": "HTTPS"}}]},
      {"ListenerArn": "arn:aws:elasticloadbalancing:eu-west-3:111122223333:listener/app/portail/1/https",
       "Protocol": "HTTPS", "Port": 443, "SslPolicy": "ELBSecurityPolicy-TLS13-1-2-2021-06"}]}},
    "AWS-14": {"raw": {"Instances": [
