      {"PolicyName": "LegacyAdmin", "Arn": "arn:aws:iam::111122223333:policy/LegacyAdmin",
       "AttachmentCount": 0, "Document": {"Statement": [{"Effect": "Allow", "Action": "*", "Resource": "*"}]}}]}},
    "AWS-06": {"raw": {
      "AccountPublicAccessBlock": {"BlockPublicAcls": true, "IgnorePublicAcls": true, "BlockPublicPolicy": true, "RestrictPublicBuckets": true},
