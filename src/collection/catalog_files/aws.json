{
  "provider": "aws",
  "version": 1,
  "label": {"en": "Amazon Web Services", "fr": "Amazon Web Services"},
  "connection": {
    "fields": [
      {"id": "access_key_id", "secret": true, "required": true,
       "label": {"en": "Access key ID of the IAM user that assumes the role", "fr": "Identifiant de la clé d'accès de l'utilisateur IAM qui prend le rôle"}},
      {"id": "secret_access_key", "secret": true, "required": true,
       "label": {"en": "Secret access key", "fr": "Clé d'accès secrète"}},
      {"id": "role_arn", "secret": false, "required": true,
       "label": {"en": "Read-only IAM role (ARN)", "fr": "Rôle IAM en lecture seule (ARN)"}},
      {"id": "external_id", "secret": false, "required": false, "generated": true,
       "label": {"en": "External ID (generated by the suite, to put in the role's trust policy)", "fr": "Identifiant externe (généré par la suite, à mettre dans la relation de confiance du rôle)"}},
      {"id": "regions", "secret": false, "required": false,
       "label": {"en": "Regions in use (empty: all enabled regions)", "fr": "Régions utilisées (vide : toutes les régions activées)"}}
    ],
    "permissions": ["sts:AssumeRole", "backup:ListProtectedResources", "cloudtrail:DescribeTrails",
                    "cloudtrail:GetTrailStatus", "ec2:DescribeFlowLogs", "ec2:DescribeInstances",
                    "ec2:DescribeRegions", "ec2:DescribeSecurityGroups", "ec2:DescribeVpcs",
                    "ec2:GetEbsEncryptionByDefault", "elasticloadbalancing:DescribeListeners",
                    "elasticloadbalancing:DescribeLoadBalancers", "guardduty:GetDetector",
                    "guardduty:ListDetectors", "iam:GenerateCredentialReport", "iam:GetAccountAuthorizationDetails",
                    "iam:GetAccountPasswordPolicy", "iam:GetCredentialReport", "rds:DescribeDBInstances",
                    "s3:GetAccountPublicAccessBlock", "s3:GetBucketPolicyStatus",
                    "s3:GetEncryptionConfiguration", "s3:ListAllMyBuckets", "securityhub:DescribeHub"]
  },
  "profiles": {
    "configuration": {"daily_days": 7, "weekly_days": 61, "monthly_days": 1096},
    "accounts":      {"daily_days": 7, "weekly_days": 61, "monthly_days": 396},
    "backups":       {"daily_days": 35, "weekly_days": 92, "monthly_days": 1096}
  },
  "collectors": [
    {"code": "AWS-01", "version": 1, "retention_profile": "accounts",
     "title": {"en": "Root account protected and unused", "fr": "Compte racine protégé et inutilisé"},
     "rule": {"en": "MFA enabled on the root account, no access key, no sign-in for 30 days.",
              "fr": "MFA active sur le compte racine, aucune clé d'accès, aucune connexion depuis 30 jours."},
     "reads": ["iam:GenerateCredentialReport", "iam:GetCredentialReport"],
     "permissions": ["iam:GenerateCredentialReport", "iam:GetCredentialReport"],
     "requirements": {"iso": ["A.8.2", "A.8.5"], "anssi": ["13"], "nis2": ["21.2.j"], "soc2": ["CC6.1"]}},
    {"code": "AWS-02", "version": 1, "retention_profile": "accounts",
     "title": {"en": "MFA for IAM users with console access", "fr": "MFA des utilisateurs IAM avec console"},
     "rule": {"en": "Every IAM user with a password has MFA enabled.",
              "fr": "Tout utilisateur IAM doté d'un mot de passe a la MFA active."},
     "reads": ["iam:GenerateCredentialReport", "iam:GetCredentialReport"],
     "permissions": ["iam:GenerateCredentialReport", "iam:GetCredentialReport"],
     "requirements": {"iso": ["A.5.17", "A.8.5"], "anssi": ["13"], "nis2": ["21.2.j"], "soc2": ["CC6.1"]}},
    {"code": "AWS-03", "version": 1, "retention_profile": "accounts",
     "title": {"en": "Access keys rotated", "fr": "Clés d'accès renouvelées"},
     "rule": {"en": "No active access key older than 90 days, no active key unused for 45 days.",
              "fr": "Aucune clé active de plus de 90 jours, aucune clé active inutilisée depuis 45 jours."},
     "reads": ["iam:GenerateCredentialReport", "iam:GetCredentialReport"],
     "permissions": ["iam:GenerateCredentialReport", "iam:GetCredentialReport"],
     "params": [{"id": "max_age_days", "default": 90, "min": 30, "max": 365},
                {"id": "max_unused_days", "default": 45, "min": 7, "max": 365}],
     "requirements": {"iso": ["A.5.17", "A.5.18"], "anssi": ["8"], "nis2": ["21.2.i"], "soc2": ["CC6.2"]}},
    {"code": "AWS-04", "version": 1, "retention_profile": "configuration",
     "title": {"en": "IAM password policy", "fr": "Politique de mot de passe IAM"},
     "rule": {"en": "Minimum length 14, reuse of the last 24 passwords forbidden.",
              "fr": "Longueur minimale 14, réutilisation des 24 derniers mots de passe interdite."},
     "reads": ["iam:GetAccountPasswordPolicy"],
     "permissions": ["iam:GetAccountPasswordPolicy"],
     "requirements": {"iso": ["A.5.17"], "anssi": ["10"], "nis2": ["21.2.i"], "soc2": ["CC6.1"]}},
    {"code": "AWS-05", "version": 1, "retention_profile": "accounts",
     "title": {"en": "No all-powerful permissions", "fr": "Pas de droits « tout sur tout »"},
     "rule": {"en": "No customer policy granting Action:* on Resource:* attached to a user, group or role.",
              "fr": "Aucune politique client Action:* Resource:* attachée à un utilisateur, un groupe ou un rôle."},
     "reads": ["iam:GetAccountAuthorizationDetails"],
     "permissions": ["iam:GetAccountAuthorizationDetails"],
     "requirements": {"iso": ["A.5.15", "A.8.2"], "anssi": ["9", "29"], "nis2": ["21.2.i"], "soc2": ["CC6.3"]}},
    {"code": "AWS-06", "version": 1, "retention_profile": "configuration",
     "title": {"en": "S3 storage not public", "fr": "Stockage S3 non public"},
     "rule": {"en": "The four public-access blocks are on at account level, and no bucket is public.",
              "fr": "Les quatre blocages d'accès public sont actifs au niveau du compte, et aucun compartiment n'est public."},
     "reads": ["s3control:GetPublicAccessBlock", "s3:ListAllMyBuckets", "s3:GetBucketPolicyStatus"],
     "permissions": ["s3:GetAccountPublicAccessBlock", "s3:ListAllMyBuckets", "s3:GetBucketPolicyStatus"],
     "requirements": {"iso": ["A.8.3", "A.8.12"], "anssi": ["23"], "nis2": ["21.2.i"], "soc2": ["CC6.1", "CC6.6"]}},
    {"code": "AWS-07", "version": 1, "retention_profile": "configuration",
     "title": {"en": "Encryption at rest", "fr": "Chiffrement au repos"},
     "rule": {"en": "S3 and EBS default encryption on in every region used, every RDS database encrypted.",
              "fr": "Chiffrement par défaut S3 et EBS dans chaque région utilisée, toute base RDS chiffrée."},
     "reads": ["ec2:DescribeRegions", "s3:ListAllMyBuckets", "s3:GetEncryptionConfiguration", "ec2:GetEbsEncryptionByDefault", "rds:DescribeDBInstances"],
     "permissions": ["ec2:DescribeRegions", "s3:ListAllMyBuckets", "s3:GetEncryptionConfiguration", "ec2:GetEbsEncryptionByDefault", "rds:DescribeDBInstances"],
     "requirements": {"iso": ["A.8.24"], "anssi": ["31"], "nis2": ["21.2.h"], "soc2": ["CC6.1"]}},
    {"code": "AWS-08", "version": 1, "retention_profile": "configuration",
     "title": {"en": "CloudTrail logging", "fr": "Journalisation CloudTrail"},
     "rule": {"en": "An active multi-region trail with log file validation.",
              "fr": "Une piste multi-région active avec validation d'intégrité des journaux."},
     "reads": ["cloudtrail:DescribeTrails", "cloudtrail:GetTrailStatus"],
     "permissions": ["cloudtrail:DescribeTrails", "cloudtrail:GetTrailStatus"],
     "requirements": {"iso": ["A.8.15"], "anssi": ["36"], "nis2": ["21.2.b"], "soc2": ["CC7.2"]}},
    {"code": "AWS-09", "version": 1, "retention_profile": "configuration",
     "title": {"en": "No administration port open to the Internet", "fr": "Pas d'administration ouverte sur Internet"},
     "rule": {"en": "No security group allows 22 or 3389 from 0.0.0.0/0 or ::/0.",
              "fr": "Aucun groupe de sécurité n'autorise 22 ou 3389 depuis 0.0.0.0/0 ou ::/0."},
     "reads": ["ec2:DescribeRegions", "ec2:DescribeSecurityGroups"],
     "permissions": ["ec2:DescribeRegions", "ec2:DescribeSecurityGroups"],
     "requirements": {"iso": ["A.8.20", "A.8.22"], "anssi": ["23", "28"], "nis2": ["21.2.e"], "soc2": ["CC6.6"]}},
    {"code": "AWS-10", "version": 1, "retention_profile": "backups",
     "title": {"en": "Backups that work", "fr": "Sauvegardes effectives"},
     "rule": {"en": "A recovery point completed the day before for every protected resource; RDS retention of at least 7 days.",
              "fr": "Un point de restauration réussi la veille pour chaque ressource protégée ; rétention RDS d'au moins 7 jours."},
     "reads": ["ec2:DescribeRegions", "backup:ListProtectedResources", "rds:DescribeDBInstances"],
     "permissions": ["ec2:DescribeRegions", "backup:ListProtectedResources", "rds:DescribeDBInstances"],
     "requirements": {"iso": ["A.8.13"], "anssi": ["37"], "nis2": ["21.2.c"], "soc2": ["A1.2"]}},
    {"code": "AWS-11", "version": 1, "retention_profile": "configuration",
     "title": {"en": "Threat detection on", "fr": "Détection des menaces active"},
     "rule": {"en": "GuardDuty and Security Hub enabled in every region used.",
              "fr": "GuardDuty et Security Hub activés dans toutes les régions utilisées."},
     "reads": ["ec2:DescribeRegions", "guardduty:ListDetectors", "guardduty:GetDetector", "securityhub:DescribeHub"],
     "permissions": ["ec2:DescribeRegions", "guardduty:ListDetectors", "guardduty:GetDetector", "securityhub:DescribeHub"],
     "requirements": {"iso": ["A.8.7", "A.8.16"], "anssi": [], "nis2": ["21.2.b"], "soc2": ["CC7.2"]}},
    {"code": "AWS-12", "version": 1, "retention_profile": "configuration",
     "title": {"en": "Network flow logs", "fr": "Journaux de flux réseau"},
     "rule": {"en": "Every VPC has an active flow log.",
              "fr": "Chaque VPC a un journal de flux actif."},
     "reads": ["ec2:DescribeRegions", "ec2:DescribeVpcs", "ec2:DescribeFlowLogs"],
     "permissions": ["ec2:DescribeRegions", "ec2:DescribeVpcs", "ec2:DescribeFlowLogs"],
     "requirements": {"iso": ["A.8.15", "A.8.16"], "anssi": ["36"], "nis2": ["21.2.b"], "soc2": ["CC7.2"]}},
    {"code": "AWS-13", "version": 1, "retention_profile": "configuration",
     "title": {"en": "Encryption in transit", "fr": "Chiffrement en transit"},
     "rule": {"en": "Load balancer HTTP listeners redirect to HTTPS, TLS policy 1.2 or later.",
              "fr": "Les écouteurs HTTP des répartiteurs de charge redirigent vers HTTPS, politique TLS 1.2 au moins."},
     "reads": ["ec2:DescribeRegions", "elasticloadbalancing:DescribeLoadBalancers", "elasticloadbalancing:DescribeListeners"],
     "permissions": ["ec2:DescribeRegions", "elasticloadbalancing:DescribeLoadBalancers", "elasticloadbalancing:DescribeListeners"],
     "requirements": {"iso": ["A.8.21", "A.8.24"], "anssi": ["18", "21"], "nis2": ["21.2.h"], "soc2": ["CC6.7"]}},
    {"code": "AWS-14", "version": 1, "retention_profile": "configuration",
     "title": {"en": "Instance metadata protected", "fr": "Métadonnées d'instance protégées"},
     "rule": {"en": "IMDSv2 required on every EC2 instance.",
              "fr": "IMDSv2 obligatoire sur toutes les instances EC2."},
     "reads": ["ec2:DescribeRegions", "ec2:DescribeInstances"],
     "permissions": ["ec2:DescribeRegions", "ec2:DescribeInstances"],
     "requirements": {"iso": ["A.8.9"], "anssi": ["14"], "nis2": ["21.2.e"], "soc2": ["CC7.1"]}}
  ]
}
